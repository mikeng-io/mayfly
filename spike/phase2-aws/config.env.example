# Copy to config.env (gitignored) and fill in. Uses AWS creds from your shell
# (env vars, AWS_PROFILE, or `aws sso login`). GITHUB_PAT is read from repo-root .env.
# The S3 bucket + build role are NOT set here — they come from CDK (infra/), read
# from cdk-outputs.json.

AWS_REGION=ap-northeast-1
IMAGE_NAME=mayfly-runner
# BASE_IMAGE_ARN defaults to arn:aws:lambda:${AWS_REGION}:aws:microvm-image:al2023-1
